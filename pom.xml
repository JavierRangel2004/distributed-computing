<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mx.edu.up.computing</groupId>
    <artifactId>distributed-computing</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!--
        Proyecto Parcial 2 - Arquitectura ADS (Campo de Datos en malla completa).
        Manifest principal: mx.edu.up.computing.ads.NodeMain.
        El parcial 1 (calculadora 3 capas) se conserva como entregable histórico;
        su main sigue disponible ejecutando:
            java -cp target/distributed-computing-1.0.0-jar-with-dependencies.jar \
                 mx.edu.up.computing.middleware.MiddlewareMain
    -->
    <name>Calculadora Distribuida ADS</name>
    <description>
        Sistema distribuido ADS (Autonomous Decentralized Systems) para el parcial 2:
        nodos iguales en malla completa con broadcast por contenido, células GUI y
        servidor configurables por servicio (SUM/SUB/MUL/DIV), Códigos de Contenido
        *_REQ/*_RES, deduplicación atómica por messageId, anuncios periódicos con
        lease y selección de ejecutor único por UUID de instancia. Sin coordinador
        central; los historiales ADS viven en data/ads/.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <flatlaf.version>3.5.4</flatlaf.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencies>
        <!-- Modern look-and-feel para clientes gráficos Swing -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- Serialización y deserialización JSON para sockets y persistencia -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- JUnit 5 para pruebas automatizadas de integración de sockets -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin de compilación Java 21+ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- Fat JAR con todas las dependencias para ejecución portable -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <!--
                                Main activo: nodo ADS. El parcial 1 sigue disponible
                                invocando explícitamente su middleware.
                            -->
                            <mainClass>mx.edu.up.computing.ads.NodeMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Ejecución directa de clases main desde Maven -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>

            <!-- Pruebas JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>